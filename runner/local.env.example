# Copy to runner/local.env (never committed) and fill in. Read by runner/run_job.sh.
# DRIVE: an rclone remote whose root is the shared CS787-Diffusion folder (see HANDOFF.md, step 3). Keep the colon.
DRIVE=cs787shared:
# rclone config file that holds that remote. This whole file is uploaded to your own Colab VM, so keep only this remote in it.
RCLONE_CONF=~/.config/rclone/cs787.conf
# Colab CLI binary, and the session name this runner creates and is allowed to stop. Never reuse a name you use yourself.
COLAB=colab
SESSION=cs787-runner
GPU=G4
# Refuse to start below this many CU, and give up after this many lost VMs.
MIN_CU=15
MAX_RESTARTS=2
